{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAC",
  "version": "0.1.0",
  "identifier": "com.hac.codexmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "HAC — Thiết lập Codex", "width": 1020, "height": 800, "minWidth": 640, "minHeight": 680 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "11.0" } }
}
